# Path to your tweets.js file from the X/Twitter archive
TWEETS_FILE=twitter/data/tweets.js

# Optional: where resume progress is stored
PROGRESS_FILE=.delete-progress.json

# Optional: wait 5 minutes between rate-limit checks
RATE_LIMIT_CHECK_INTERVAL_SECONDS=300

# Browser request headers copied from a logged-in X/Twitter session.
# Keep each value on a single line. Quotes are recommended for COOKIE.
AUTHORIZATION="Bearer AAAAAAAAAAAAAAAAAAAA..."
X_CSRF_TOKEN="xxxxx..."
COOKIE="ct0=...; auth_token=...; ..."

# Optional fallback if you prefer a separate headers file instead of env vars
# REQUEST_HEADERS_FILE=request-headers.txt
